# Порт. На Bothost не задавай вручную: платформа передаёт PORT сама.
PORT=3001

# Домен Mini App. На Bothost: https://твой-домен.bothost.tech
# Если фронт и API на одном домене, CORS не нужен: оставь пустым.
# Если фронт на Vercel: укажи https://проект.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

BOT_TOKEN=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram ID админов через запятую. Свой ID смотри в Supabase -> users -> telegram_id
ADMIN_TELEGRAM_IDS=

# Адрес Mini App (https). Нужен боту для кнопки «Играть» и вебхука.
WEBAPP_URL=

# Секрет вебхука: придумай длинную случайную строку, например:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Один и тот же секрет должен быть в Bothost и в Telegram (его ставит bot:prod).
TELEGRAM_WEBHOOK_SECRET=

# Только если API на отдельном домене от Mini App. Иначе оставь пустым.
PUBLIC_API_URL=
