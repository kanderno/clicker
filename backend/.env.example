PORT=3001
# Через запятую, если несколько. Для режима с прокси Vite можно оставить как есть.
FRONTEND_ORIGIN=http://localhost:5173
BOT_TOKEN=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Telegram ID админов (через запятую). Свой ID смотри в Supabase -> таблица users -> telegram_id
ADMIN_TELEGRAM_IDS=
# Приветствие бота. WEBAPP_URL и TELEGRAM_WEBHOOK_SECRET заполняет команда: npm run bot:setup -- https://адрес-фронтенда [--webhook]
WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=
# Только для продакшена, если бэкенд на отдельном адресе (иначе берётся WEBAPP_URL + /api)
PUBLIC_API_URL=
